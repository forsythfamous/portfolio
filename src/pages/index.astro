---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Method from '../components/Method.astro';
import WorkCards from '../components/WorkCards.astro';
import Upstream from '../components/Upstream.astro';
import Notes from '../components/Notes.astro';
import About from '../components/About.astro';
import Elsewhere from '../components/Elsewhere.astro';
---

<Base>
  <div class="container">
    <Hero />
    <div class="spine">
      <Method />
      <WorkCards />
      <Upstream />
      <Notes />
      <About />
      <Elsewhere />
    </div>
  </div>
</Base>
