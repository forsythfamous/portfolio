---
import { getCollection } from 'astro:content';

const studies = (await getCollection('caseStudies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title">Case studies</h2>
      </div>
      <p class="meta">Problem → decisions → outcome</p>
    </div>

    <ol class="list" role="list">
      {studies.map((s, i) => (
        <li>
          <a class="item" href={`/work/${s.id}`}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="body">
              <span class="context">{s.data.context}{s.data.private && ' · private source'}</span>
              <span class="title">{s.data.title}</span>
              <span class="summary">{s.data.summary}</span>
              <span class="outcome">
                <span class="dot" data-state="ok" aria-hidden="true"></span>
                {s.data.outcome}
              </span>
            </span>
            <svg class="icon arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 24px;
    gap: var(--s-4);
    align-items: start;
    padding: var(--s-5) var(--s-3);
    margin-inline: calc(var(--s-3) * -1);
    border-bottom: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 160ms var(--ease);
  }

  .item:hover {
    background: var(--surface);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
    padding-top: 3px;
  }

  .body {
    display: grid;
    gap: var(--s-2);
  }

  .context {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.3;
  }

  .summary {
    color: var(--fg-2);
    max-width: 70ch;
  }

  .outcome {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-text);
  }

  .arrow {
    margin-top: 6px;
    color: var(--fg-muted);
    transition: transform 160ms var(--ease), color 160ms var(--ease);
  }

  .item:hover .arrow {
    transform: translateX(3px);
    color: var(--accent-text);
  }

  @media (max-width: 640px) {
    .item {
      grid-template-columns: minmax(0, 1fr) 20px;
    }

    .num {
      display: none;
    }
  }
</style>
