---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import Topology from './Topology.astro';
import { diagrams } from '../data/diagrams';

const studies = (await getCollection('caseStudies', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="section w-wide" aria-labelledby="work-title">
  <SectionHead path="/work" title="Selected work" id="work-title">
    Each one: the architecture, the decisions and what they cost, how it fails, and the evidence.
  </SectionHead>
  <ul class="cards" role="list">
    {studies.map((s) => (
      <li>
        <a class="card" href={`/work/${s.id}/`}>
          <div class="thumb">
            <Topology diagram={diagrams[s.data.diagram]} mode="thumb" />
          </div>
          <span class="path meta">/work/{s.id}</span>
          <h3>{s.data.title}</h3>
          <p class="core">{s.data.core}</p>
          <p class="meta foot">
            {s.data.source === 'private' ? 'private source' : 'public source'} · {s.data.decisions.length} decisions · {s.data.period}
          </p>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
  }

  .card {
    display: grid;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .thumb {
    padding: 14px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    margin-bottom: 8px;
    transition: border-color 150ms var(--ease);
  }

  .thumb :global(.topo) {
    opacity: 0.75;
    transition: opacity 150ms var(--ease);
  }

  .card:hover .thumb,
  .card:focus-visible .thumb {
    border-color: var(--graphic);
  }

  .card:hover .thumb :global(.topo),
  .card:focus-visible .thumb :global(.topo) {
    opacity: 1;
  }

  .path {
    color: var(--accent-text);
  }

  .card:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .core {
    color: var(--fg-2);
  }

  @media (max-width: 860px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
