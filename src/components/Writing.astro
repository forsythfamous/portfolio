---
import { data } from '../data/site-data';
import { profile } from '../data/profile';

const articles = data.articles.slice(0, 5);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

{articles.length > 0 && (
  <section id="writing" class="section" aria-labelledby="writing-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Writing</p>
          <h2 id="writing-title">Technical guides</h2>
        </div>
        <a class="meta" href={profile.links.devto}>All articles on dev.to ↗</a>
      </div>
      <ul class="articles" role="list">
        {articles.map((a) => (
          <li>
            <a href={a.url}>
              <span class="title">{a.title}</span>
              <span class="meta">
                <time datetime={a.publishedAt}>{fmt.format(new Date(a.publishedAt))}</time> · {a.readingMinutes} min
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .articles {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-1) var(--s-5);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .title {
    color: var(--fg);
    font-weight: 500;
    flex: 1 1 32ch;
  }

  a:hover .title {
    color: var(--accent-text);
  }

  .meta {
    white-space: nowrap;
  }
</style>
