---
import { profile } from '../data/profile';

const links = [
  { label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
  { label: 'LinkedIn', value: 'in/forsythazure', href: profile.links.linkedin },
  { label: 'GitHub', value: 'forsythfamous', href: profile.links.github },
  { label: 'dev.to', value: 'forsyth_famous_', href: profile.links.devto },
];
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container grid">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Let's talk about your platform.</h2>
      <p class="text">
        I'm open to senior cloud infrastructure, platform and DevOps roles in Kraków, hybrid or remote. Email is the
        fastest way to reach me.
      </p>
      <a class="btn btn-primary" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
    <ul class="links" role="list">
      {links.map((l) => (
        <li>
          <a href={l.href}>
            <span class="label">{l.label}</span>
            <span class="value">{l.value}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--s-7);
    align-items: end;
  }

  h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .text {
    margin: var(--s-4) 0 var(--s-6);
    max-width: 52ch;
  }

  .btn {
    overflow-wrap: anywhere;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .links a {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 52px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  .value {
    color: var(--fg);
    overflow-wrap: anywhere;
    text-align: right;
  }

  .links a:hover .value {
    color: var(--accent-text);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }

    /* Last section: tall enough that the Contact link can scroll it to the top. */
    #contact {
      min-height: calc(100svh - 64px - 88px);
    }
  }
</style>
