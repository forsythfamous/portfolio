---
import { stats } from '../data/profile';
---

<section class="container" aria-label="Track record">
  <dl class="stats">
    {stats.map((s) => (
      <div class="stat">
        <dt>{s.label}</dt>
        <dd>{s.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 var(--s-8);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--s-2);
    padding: var(--s-5);
    border-left: 1px solid var(--line);
  }

  .stat:first-child {
    border-left: 0;
  }

  dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.02em;
  }

  dt {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--fg-muted);
  }

  @media (max-width: 860px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat:nth-child(3) {
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 420px) {
    .stats {
      grid-template-columns: 1fr;
    }

    .stat {
      border-left: 0;
    }

    .stat:nth-child(n + 2) {
      border-top: 1px solid var(--line);
    }
  }
</style>
