---
// Status of this site's own pipeline. Every value comes from the build-time
// fetch (src/data/generated.json) or, for the edge row, from a request the
// visitor's browser makes to /status.json. Nothing here is hard-coded.
import { data } from '../data/site-data';

type State = 'ok' | 'warn' | 'error' | 'idle';
interface Row {
  key: string;
  label: string;
  state: State;
  value: string;
  detail: string;
  time?: string;
  href?: string;
}

const failed = (prefix: string) => data.errors.some((e) => e.source.startsWith(prefix));
const sha = data.build.sha?.slice(0, 7);

const rows: Row[] = [
  {
    key: 'deploy',
    label: 'Deploy',
    state: 'ok',
    value: sha ?? 'local build',
    detail: data.build.environment === 'ci' ? `built by CI · ${data.build.trigger}` : 'built locally',
    time: data.build.at,
    href: sha ? `https://github.com/forsythfamous/portfolio/commit/${data.build.sha}` : undefined,
  },
  data.pipeline
    ? {
        key: 'pipeline',
        label: 'Pipeline',
        state: data.pipeline.conclusion === 'success' ? 'ok' : 'error',
        value: `${data.pipeline.workflow} #${data.pipeline.runNumber}`,
        detail: data.pipeline.conclusion ?? 'unknown',
        time: data.pipeline.at,
        href: data.pipeline.url,
      }
    : {
        key: 'pipeline',
        label: 'Pipeline',
        state: failed('github.pipeline') ? 'warn' : 'idle',
        value: 'awaiting first run',
        detail: 'GitHub Actions · deploy on push + nightly',
      },
  {
    key: 'sync',
    label: 'GitHub sync',
    state: failed('github.repos') ? 'warn' : 'ok',
    value: data.contributions ? `${data.contributions.total} contributions / year` : 'contributions unavailable',
    detail: `${data.upstream.length} upstream PRs · ${data.repos.length} showcased repos`,
    time: data.build.at,
  },
  data.agent?.lastRun
    ? {
        key: 'agent',
        label: 'Case-study agent',
        state: data.agent.openDrafts > 0 ? 'warn' : 'ok',
        value: data.agent.openDrafts > 0 ? `${data.agent.openDrafts} draft${data.agent.openDrafts === 1 ? '' : 's'} awaiting review` : 'no drafts pending',
        detail: `last run ${data.agent.lastRun.conclusion}`,
        time: data.agent.lastRun.at,
        href: data.agent.lastRun.url,
      }
    : {
        key: 'agent',
        label: 'Case-study agent',
        state: 'idle',
        value: 'awaiting first run',
        detail: 'weekly · drafts gated by pull request',
      },
  {
    key: 'writing',
    label: 'Writing feed',
    state: failed('devto') ? 'warn' : 'ok',
    value: `${data.articles.length} recent articles`,
    detail: 'dev.to API',
    time: data.build.at,
  },
];

const states = rows.map((r) => r.state);
const overall: { state: State; text: string } = states.includes('error')
  ? { state: 'error', text: 'Degraded' }
  : states.includes('warn')
    ? { state: 'warn', text: 'Operational · attention needed' }
    : { state: 'ok', text: 'All systems operational' };
const pending = states.filter((s) => s === 'idle').length;
---

<section id="platform" class="section" aria-labelledby="platform-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Live</p>
        <h2 id="platform-title">Control plane</h2>
      </div>
      <p class="lede">
        This site is operated by its own pipeline. The panel below is generated by that pipeline, and the edge check runs
        in your browser right now. <a href="/work/this-site">How it works</a>
      </p>
    </div>

    <div class="panel" data-build-sha={data.build.sha ?? ''}>
      <div class="panel-head">
        <span class="path">control-plane / forsythfamous.dev</span>
        <span class="overall" data-overall>
          <span class="dot" data-state={overall.state} aria-hidden="true"></span>
          <span>
            <span data-overall-text>{overall.text}</span>
            {pending > 0 && <span class="pending"> · {pending} pending first run</span>}
          </span>
        </span>
      </div>

      <ul class="rows" role="list">
        {rows.map((row) => (
          <li class="row" data-row={row.key}>
            <span class="label">
              <span class="dot" data-state={row.state} aria-hidden="true"></span>
              {row.label}
              <span class="visually-hidden">status: {row.state}</span>
            </span>
            <span class="value">
              {row.href ? <a href={row.href}>{row.value}</a> : row.value}
            </span>
            <span class="detail">
              {row.detail}
              {row.time && (
                <>
                  {' · '}
                  <time datetime={row.time} data-relative>{row.time.slice(0, 10)}</time>
                </>
              )}
            </span>
          </li>
        ))}
        <li class="row" data-row="edge">
          <span class="label">
            <span class="dot" data-state="idle" data-edge-dot aria-hidden="true"></span>
            Edge
          </span>
          <span class="value" data-edge-value>checking…</span>
          <span class="detail" data-edge-detail>round trip measured from your browser</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<script src="/js/control-plane.js" defer is:inline></script>

<style>
  .lede {
    max-width: 52ch;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .lede a {
    color: var(--accent-text);
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .panel-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    padding: var(--s-3) var(--s-5);
    background: var(--surface-2);
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .path {
    color: var(--fg-muted);
  }

  .overall {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--fg);
  }

  .pending {
    color: var(--fg-muted);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--s-2) var(--s-5);
    align-items: baseline;
    padding: var(--s-4) var(--s-5);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .row:first-child {
    border-top: 0;
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
  }

  .value {
    color: var(--fg);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .value a {
    text-decoration-color: var(--line-strong);
  }

  .detail {
    color: var(--fg-muted);
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }

    .panel-head {
      padding-inline: var(--s-4);
    }

    .row {
      padding-inline: var(--s-4);
    }
  }
</style>
