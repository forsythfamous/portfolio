---
import { appliedSkills, capabilities, certifications } from '../data/profile';
---

<section id="credentials" class="section" aria-labelledby="credentials-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Verified</p>
        <h2 id="credentials-title">Credentials & capabilities</h2>
      </div>
      <p class="meta">Every credential links to its Microsoft Learn record</p>
    </div>

    <div class="grid">
      <ul class="certs" role="list">
        {certifications.map((c) => (
          <li>
            <a class="cert" href={c.url} rel="noopener">
              <span class="code">{c.code}</span>
              <span>
                <span class="name">{c.name}</span>
                <span class="issuer">{c.issuer} · verify ↗</span>
              </span>
            </a>
          </li>
        ))}
        <li>
          <a class="cert" href={appliedSkills.url} rel="noopener">
            <span class="code">×{appliedSkills.count}</span>
            <span>
              <span class="name">Microsoft Applied Skills</span>
              <span class="issuer">{appliedSkills.note} · verify ↗</span>
            </span>
          </a>
        </li>
      </ul>

      <dl class="caps">
        {capabilities.map((c) => (
          <div class="cap">
            <dt>{c.area}</dt>
            <dd>{c.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: var(--s-7);
    align-items: start;
  }

  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .cert {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--s-4);
    align-items: center;
    padding: var(--s-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 160ms var(--ease);
  }

  .cert:hover {
    border-color: var(--accent);
  }

  .code {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--accent-text);
  }

  .name {
    display: block;
    color: var(--fg);
    font-weight: 500;
  }

  .issuer {
    display: block;
    font-size: 0.82rem;
    color: var(--fg-muted);
  }

  .caps {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }

  .cap {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-muted);
    padding-top: 2px;
  }

  dd {
    margin: 0;
    color: var(--fg-2);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .cap {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>
